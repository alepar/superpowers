+  console.error('usage: scope-dispositions --project RUN_MD [--keys] [--external JSON]');
+  process.exit(2);
+}
+for (let i = 0; i < args.length; i++) {
+  if (args[i] === '--project' && !run && args[i + 1]) run = args[++i];
+  else if (args[i] === '--external' && !external && args[i + 1]) external = args[++i];
