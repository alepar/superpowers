+{
+  "mode": "pr",
+  "profile": "not supplied by the caller — infer it from the repository and state it",
+  "inputs": "integration@7ddd110053fb302c4f6a0bd645ddbf28c512c563 vs 96ba44f6f5ced6166997c74aee1ba374b6c3fe0f",
