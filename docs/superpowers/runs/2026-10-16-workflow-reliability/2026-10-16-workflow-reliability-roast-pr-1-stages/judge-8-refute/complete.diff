++const report = opt.reportDir ? (() => {
++  const d = new Date(), pad = n => String(n).padStart(2, '0')
++  const date = opt.date ?? `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`
