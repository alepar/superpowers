++      p = fillCategory(p, name, 'lens', `${file} lens ${name}`)
++      assertClean(p, `scout ${name}`)
++      prompts.scouts[name] = p
++    }
++  }
++  if (!prompts.scoutDomainTemplate) drift(`${file}: domain template not found`)
