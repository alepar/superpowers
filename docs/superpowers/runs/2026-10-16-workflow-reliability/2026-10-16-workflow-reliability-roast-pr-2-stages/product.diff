+const files=new Map([
+ [prefix+'.md.diff','direct package original\n'],
+ [prefix+'.md',review],
+ [prefix+'.cluster-1.md',review],
+ ['assembled/'+prefix+'-final/clusters.json','{"clusters":[{"name":"core","slices":["slices/core.diff"]}]}\n'],
