#!/usr/bin/env bash
# Find, and by default stop, this user's processes that belong to a run. A process matches when its
# working directory or executable is under a root, when its HOME= or TMPDIR= value (exactly those
# two variables) is under a root, or — only for an orphan reparented to PID 1 — when one of its
# arguments is a path under a root. Nothing matches by name, and a match never pulls in its
# children or parents. (macOS hides the environment of its own platform binaries, so there
# HOME/TMPDIR is seen only for the user's own executables.)
#
# Roots must be leaf run directories: a task worktree, the task-worktree directory, a run temp dir,
# a run directory. A root that is or contains a git worktree with other worktrees nested under it
# (an epic/integration worktree, the main checkout) is refused, and so is a root that contains the
# working directory of this process or any of its ancestors: those are where a coordinating session
# and the user work. This script's own process, its ancestors, its children and PID 1 are never
# candidates.
#
# Usage:
#   bash stop-run-processes [--check] ROOT [ROOT...]
#
# --check lists matches without signalling anything: `match: <pid> <command> — <why>`, exit 3 when
# anything matched or was kept, 0 only after verified discovery found nothing. Default mode stops
# each match (TERM, then KILL after 3 s)
# and prints `stopped: <pid> <command> — <why>` or `survived: <pid> <command> — <why>` (alive after
# KILL), exit 3 when anything survived or was deliberately kept, 0 otherwise.
# `unknown: <root-or-pid> — <failed inspection>` and exit 4 mean discovery or termination could
# not be verified. Unknown takes precedence over 3. Exit 2 on bad input.
set -euo pipefail

check=
if [ "${1:-}" = --check ]; then check=1; shift; fi
[ $# -ge 1 ] || { echo "usage: stop-run-processes [--check] ROOT [ROOT...]" >&2; exit 2; }

# Each root in both spellings: as given and physically resolved (/tmp vs /private/tmp on macOS).
roots=()
for r in "$@"; do
  case "$r" in /*) ;; *) echo "root must be absolute: $r" >&2; exit 2 ;; esac
  r=${r%/}
  [ -n "$r" ] && [ "$r" != / ] || { echo "refusing root: /" >&2; exit 2; }
  roots+=("$r")
  if [ -d "$r" ]; then p=$(cd "$r" && pwd -P); [ "$p" = "$r" ] || roots+=("$p"); fi
done

contains() {  # $1 root, $2 path: true when path is the root or inside it
  case "$2" in "$1"|"$1"/*) return 0 ;; esac; return 1
}
# Refuse a root holding a parent worktree (one with other worktrees nested under it).
for r in "${roots[@]}"; do
  [ -d "$r" ] || continue
  wts=$(git -C "$r" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' || true)
  [ -n "$wts" ] || continue
  while IFS= read -r w; do
    [ -n "$w" ] || continue
    contains "$r" "$w" || continue
    nested=$(grep -c "^$w/" <<<"$wts" || true)
    if [ "$nested" -gt 0 ]; then
      echo "refusing root $r: it holds worktree $w, which has worktrees nested under it (an epic/integration or main checkout); pass task worktrees, the task-worktree directory or run temp dirs instead" >&2
      exit 2
    fi
  done <<<"$wts"
done

under() {  # $1 = a path; true when it is a root or inside one
  local root
  for root in "${roots[@]}"; do
    case "$1" in "$root"|"$root"/*) return 0 ;; esac
  done
  return 1
}

unknown=0
unknown_roots() {
  local root
  for root in "${roots[@]}"; do echo "unknown: $root — $1"; done
  unknown=1
}
# ps -p exits 1 for both absence and inspection failure. Only a successful all-PID
# enumeration without the PID proves disappearance in that case.
absent() {
  local all
  all=$(ps -A -o pid= 2>/dev/null) || return 1
  ! awk -v p="$1" '$1==p{found=1} END{exit !found}' <<<"$all"
}
uid=$(id -u)
# Never this process, its ancestors, its own children (subshells and the ps/lsof it runs carry
# the roots in their arguments), or PID 1.
if ! ppids=$(ps -A -o pid=,ppid= 2>/dev/null); then unknown_roots "ps ancestry discovery failed"; exit 4; fi
ppid_of() {  # from the snapshot, else live (children started after the snapshot)
  local r; r=$(awk -v p="$1" '$1==p{print $2; exit}' <<<"$ppids")
  if [ -z "$r" ]; then r=$(ps -o ppid= -p "$1" 2>/dev/null | tr -d ' ') || return 4; fi
  [ -n "$r" ] || return 4
  echo "$r"
}
skip=" 1 $$ "
p=$$
while [ -n "$p" ] && [ "$p" != 0 ] && [ "$p" != 1 ]; do
  if ! p=$(ppid_of "$p"); then unknown_roots "ps ancestor inspection failed"; exit 4; fi
  [ -n "$p" ] && skip="$skip$p "
done
# Refuse a root that contains the working directory of this process or any ancestor.
for a in $skip; do
  [ "$a" = 1 ] && continue
  if [ -r "/proc/$a/cwd" ]; then
    if ! acwd=$(readlink "/proc/$a/cwd" 2>/dev/null); then unknown_roots "ancestor $a cwd inspection failed"; exit 4; fi
  else
    if ! acwd=$(lsof -w -a -p "$a" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1); then
      # Privileged launch/login ancestors are outside this user's cleanup candidates and
      # may hide cwd on macOS. Successful ownership inspection can exclude them.
      if ancestor_uid=$(ps -o uid= -p "$a" 2>/dev/null | tr -d ' ') && [ -n "$ancestor_uid" ] && [ "$ancestor_uid" != "$uid" ]; then continue; fi
      unknown_roots "ancestor $a cwd inspection failed"; exit 4
    fi
  fi
  [ -n "$acwd" ] || continue
  for r in "${roots[@]}"; do
    if contains "$r" "$acwd"; then echo "refusing root $r: it contains the working directory of this process or an ancestor ($acwd)" >&2; exit 2; fi
  done
done
is_ours() {  # $1 pid; true when it descends from this process
  local q=$1 n=0
  while [ -n "$q" ] && [ "$q" != 0 ] && [ "$q" != 1 ] && [ $n -lt 64 ]; do
    [ "$q" = "$$" ] && return 0
    q=$(ppid_of "$q") || return 4; n=$((n + 1))
  done
  return 1
}

matches=""
add() {  # $1 pid $2 reason
  case "$skip" in *" $1 "*) return 0 ;; esac
  case " $matches " in *" $1 "*) return 0 ;; esac
  local ancestry=0
  is_ours "$1" || ancestry=$?
  [ "$ancestry" != 0 ] || return 0
  if [ "$ancestry" = 4 ]; then
    absent "$1" || unknown_roots "process $1 ancestry inspection failed"
    return 0
  fi
  matches="$matches $1"
  eval "why_$1=\$2"
}

if [ -d /proc/self ] && [ -r /proc/self/environ ]; then
  for d in /proc/[0-9]*; do
    pid=${d#/proc/}
    if ! owner=$(stat -c %u "$d" 2>/dev/null); then
      absent "$pid" || unknown_roots "process $pid ownership inspection failed"
      continue
    fi
    [ "$owner" = "$uid" ] || continue
    if path=$(readlink "$d/cwd" 2>/dev/null); then
      [ -n "$path" ] && under "$path" && { add "$pid" "cwd $path"; continue; }
    else absent "$pid" || unknown_roots "process $pid cwd inspection failed"; fi
    if path=$(readlink "$d/exe" 2>/dev/null); then
      [ -n "$path" ] && under "$path" && { add "$pid" "exe $path"; continue; }
    else absent "$pid" || unknown_roots "process $pid executable inspection failed"; fi
    if ! env=$(tr '\0' '\n' 2>/dev/null < "$d/environ"); then
      absent "$pid" || unknown_roots "process $pid environment inspection failed"
      continue
    fi
    env=$(grep -E '^(HOME|TMPDIR)=' <<<"$env" || true)
    envhit=""
    while IFS= read -r kv; do [ -n "$kv" ] && under "${kv#*=}" && envhit="$envhit $kv"; done <<<"$env"
    [ -n "$envhit" ] && { add "$pid" "env$envhit"; continue; }
    if ! parent=$(awk '{print $4}' "$d/stat" 2>/dev/null); then
      absent "$pid" || unknown_roots "process $pid parent inspection failed"
      continue
    fi
    if [ "$parent" = 1 ]; then
      if ! args=$(tr '\0' '\n' 2>/dev/null < "$d/cmdline"); then
        absent "$pid" || unknown_roots "process $pid argument inspection failed"
        continue
      fi
      while IFS= read -r a; do [ -n "$a" ] && under "${a#*=}" && { add "$pid" "orphan arg $a"; break; }; done <<<"$args"
    fi
  done
else
  if command -v lsof >/dev/null 2>&1; then
    if ! files=$(lsof -w -a -u "$uid" -d cwd,txt -Ffpn 2>/dev/null); then
      unknown_roots "lsof cwd/executable discovery failed"
    fi
    pid=""
    while IFS= read -r line; do
      case "$line" in
        p*) pid=${line#p} ;;
        f*) fd=${line#f} ;;
        n*) path=${line#n}
            under "$path" && add "$pid" "$fd $path" ;;
      esac
    done <<<"$files"
  else
    unknown_roots "lsof cwd/executable discovery unavailable"
  fi
  # Environment: only HOME= and TMPDIR= tokens from `ps -E`, which appends the environment to the
  # command line. Arguments: only for orphans (PPID 1), one token at a time, path-boundary checked.
  if ! processes=$(ps -Eww -U "$uid" -o pid=,ppid=,command= 2>/dev/null); then
    unknown_roots "ps environment/orphan discovery failed"
  fi
  while read -r pid ppid rest; do
    [ -n "$pid" ] || continue
    hit=""
    for tok in $rest; do
      case "$tok" in HOME=*|TMPDIR=*) under "${tok#*=}" && hit="$hit $tok" ;; esac
    done
    if [ -n "$hit" ]; then add "$pid" "env$hit"; continue; fi
    if [ "$ppid" = 1 ]; then
      for tok in $rest; do
        case "$tok" in *=*) continue ;; esac
        under "$tok" && { add "$pid" "orphan arg $tok"; break; }
      done
    fi
  done <<<"$processes"
fi

# Interactive work is never stopped: a match with a controlling terminal, or one hosting a
# terminal (a descendant has one, e.g. a terminal multiplexer server with live panes), is
# reported as `kept:` for a human to decide.
if ! ptt=$(ps -A -o pid=,ppid=,tty= 2>/dev/null); then unknown_roots "ps interactive-terminal inspection failed"; exit 4; fi
has_tty() { local t; t=$(awk -v p="$1" '$1==p{print $3; exit}' <<<"$ptt"); [ -n "$t" ] && [ "$t" != "??" ] && [ "$t" != "?" ]; }
hosts_tty() {  # any descendant with a terminal
  local frontier=" $1 " next q c pp t n=0
  while [ -n "${frontier// /}" ] && [ $n -lt 32 ]; do
    next=""
    while read -r c pp t; do
      case "$frontier" in *" $pp "*) ;; *) continue ;; esac
      [ -n "$t" ] && [ "$t" != "??" ] && [ "$t" != "?" ] && return 0
      next="$next $c "
    done <<<"$ptt"
    frontier=$next; n=$((n + 1))
  done
  return 1
}
kept=""
keep=""
for pid in $matches; do
  if has_tty "$pid"; then kept="$kept$pid interactive terminal"$'\n'
  elif hosts_tty "$pid"; then kept="$kept$pid hosts an interactive terminal session"$'\n'
  else keep="$keep $pid"; continue; fi
done
matches=$keep
cmd_of0() { ps -o command= -p "$1" 2>/dev/null | cut -c1-120 || echo '?'; }
while IFS= read -r kl; do
  [ -n "$kl" ] || continue
  kp=${kl%% *}; eval "w=\${why_$kp:-}"
  echo "kept: $kp $(cmd_of0 "$kp") — ${kl#* } ($w)"
done <<<"$kept"

if [ -z "$matches" ]; then
  [ "$unknown" = 0 ] || exit 4
  [ -z "$kept" ] || exit 3
  exit 0
fi
w="" c=""
cmd_of() { ps -o command= -p "$1" 2>/dev/null | cut -c1-120 || echo '?'; }
alive() {  # 0 running, 1 verified absent/zombie, 4 unverified
  local st
  if st=$(ps -o stat= -p "$1" 2>/dev/null | tr -d ' '); then
    case "$st" in Z*) return 1 ;; ?*) return 0 ;; esac
  fi
  absent "$1" && return 1
  return 4
}

if [ -n "$check" ]; then
  for pid in $matches; do eval "w=\$why_$pid"; echo "match: $pid $(cmd_of "$pid") — $w"; done
  [ "$unknown" = 0 ] || exit 4
  exit 3
fi

live=""
for pid in $matches; do
  eval "w=\$why_$pid"; c=$(cmd_of "$pid")
  eval "cmd_$pid=\$c"
  kill -TERM "$pid" 2>/dev/null || true
  live="$live $pid"
done
for _ in 1 2 3 4 5 6; do
  any=""
  for pid in $live; do alive "$pid" && any=1; done
  [ -n "$any" ] || break
  sleep 0.5
done
for pid in $live; do alive "$pid" && kill -KILL "$pid" 2>/dev/null || true; done
sleep 0.3
rc=0
[ -z "$kept" ] || rc=3
for pid in $matches; do
  eval "w=\$why_$pid"; eval "c=\${cmd_$pid:-?}"
  state=0; alive "$pid" || state=$?
  case "$state" in
    0) echo "survived: $pid $c — $w"; rc=3 ;;
    1) echo "stopped: $pid $c — $w" ;;
    *) echo "unknown: $pid — ps termination inspection failed ($c — $w)"; unknown=1 ;;
  esac
done
[ "$unknown" = 0 ] || exit 4
exit $rc
