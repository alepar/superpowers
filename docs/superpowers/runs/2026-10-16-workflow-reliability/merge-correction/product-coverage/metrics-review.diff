+assert_has "$(cat "$T/pl.md")" "planning dominates" "Markdown preserves the planning diagnosis"
+assert_has "$out" "observed invocation/residual graph" "graph scope is explicit"
+assert_has "$out" "all-agent concurrency" "overall agents are labeled separately"
+assert_has "$out" "task-slot concurrency" "task-slot occupancy has its own label"
+OC=$(node "$ORD" "$T/residual.json" codex "$T/residual")
