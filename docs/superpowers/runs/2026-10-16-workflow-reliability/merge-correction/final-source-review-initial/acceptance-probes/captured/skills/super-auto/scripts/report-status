#!/usr/bin/env bash
# The report.md status line for one super-auto run, computed from its run.md. This script is the
# only source of the status line and its degraded qualifiers; paste its output verbatim.
#
#   report-status RUN_MD [--tip SHA] [--stalled PHASE]
#
# RUN_MD: the run's run.md (fields per run-state.md). --tip SHA: the run branch's HEAD, the commit
# the report describes; every report-prompt.md call passes it, and without it a sweep's stamp is
# still required but not compared. A stamp other than SHA is still at the tip when `git diff` finds
# no change between the two commits outside RUN_MD's directory, the run directory that phase 6
# commits run.md, friction.md and report.md into after the sweep; a git failure counts as a change.
# --stalled PHASE: the orchestrator judged the run stalled at
# PHASE, a state run.md cannot carry.
#
# Status, first match wins:
#   --stalled PHASE                         -> status: stalled at phase PHASE
#   phase: capped-blocking                  -> status: stalled at phase capped-blocking
#   codeBuckets.stalled true                -> status: stalled at phase code
#   N > 0, M > 0 or pendingRetry non-empty  -> status: completed with N unresolved Blocking, M escalations
#   otherwise                               -> status: clean
# The two non-stalled forms take ` [degraded: q1, q2, ...]` when any qualifier applies.
# N: the distinct finding keys in `roastCodeCapped:`, in `roastDesignCapped:` unless it ends
#   `stopped`, and in every Blocking row of either findings ledger whose status is `disputed`
#   (vision §4: a disputed Blocking finding is never cleared, whether or not the roast still
#   confirms it). A key is counted once however many of these hold it; `rN ` prefixes are ignored.
# M: parked `escalation` records plus ids in codeBuckets.escalated.
#
# Fields read, each with its writer and what its absent or other form gives:
#   flags (skipPlanRoast, skipCodeRoast): SKILL.md §Pre-flight step 4. No line, or a key missing: exit 2.
#   phase: SKILL.md §Who writes run.md. No line, or not a run-state.md token: exit 2.
#   parked: super-design (phases 1-2), super-auto (phase 3 on). Absent: no records. A
#     `degraded-verdict` record may end ` · resolves-on: sweep`.
#   roastDesignCapped: super-design §Adversarial Review Loop (root only). Absent: nothing; a last
#     slot other than `stopped` counts as `proceeded`.
#   roastCodeCapped: SKILL.md §Cap disposition, on a cap or thrash exit with Blocking open. Absent: nothing.
#   findingsLedger, findingsLedgerDesign: the loops' ledgers (super-design/scripts/findings-ledger
#     rows `- <key> · raised r<M>@<sha> · <status> · …`), paths relative to RUN_MD's directory.
#     Absent: nothing. A pointer to a missing file: qualifier `findings ledger not found: <path>`.
#   codeBuckets: run-state.md item 6 at each phase 3->4 transition and re-entry; `sweep` rewritten by
#     SKILL.md §Phase 6 — report steps 1 and 2. No block at phase report, finish or done: `final
#     review: none recorded` and `sweep: none recorded`; no block earlier: nothing. A bucket line
#     missing from the block: `<bucket> bucket: none recorded` (review and sweep: their own
#     `none recorded` forms).
#
# Qualifiers, in this order, each once: `design roast capped-blocking` (roastDesignCapped not
# stopped); `findings ledger not found: <path>`, per missing ledger; each parked `degraded-verdict` record's qualifier (the bracketed text in its part before
# ` — `, else that part), skipped for a ` · resolves-on: sweep` record when --tip is given and the
# sweep is a stamped pass at the tip (the sweep rules below give it no qualifier); `plan roast
# skipped` / `code roast skipped` (flags); then the codeBuckets ones: missing-bucket qualifiers,
# `code findings parked` (parked non-empty), `tasks pending retry` (pendingRetry non-empty),
# `final review: <review>` (review not `CLEAN` or `ready`, so the `<verdict> (<N> confirmed)` and
# `not ready (<summary>)` forms; `none recorded` when empty), then the sweep:
#   `sweep: <sweep>`              it is not a pass: it carries a failing signal (a non-zero failed
#                                 or errors count, FAIL, DEFERRED, INVALID, UNAVAILABLE) or lacks
#                                 the pass form `<P> passed, 0 failed, 0 errors`;
#   `sweep: unstamped — <sweep>`  a pass with no ` @ <sha>` stamp;
#   `sweep: not at tip — <sweep>` a pass whose stamp is not --tip and differs from it outside the
#                                 run directory.
#
# Prints the status line, then one `qualifier: <text>` line per qualifier, in the order above.
# Bash and awk, plus git only to compare a sweep stamp with --tip: needs no jq, so it never prints
# JQ_UNAVAILABLE.
# Ordinary status: exit 0 ok, 2 bad input; legacy records require only Bash/awk.
# Additive finding/collection records use Node for the shared projection; unavailability
# is an explicit qualifier. --collect is the settled-bundle write mode (usage below):
# exit 0 preserved, 3 evidence gaps, 2 bad input, 4 Node unavailable.
set -euo pipefail

# This is a read-only root-close gate. Requirements and producer facts live in the
# existing approvals block; neither completed leaves nor the latest verdict supplies them.
if [ "${1:-}" = --acceptance ]; then
  command -v node >/dev/null 2>&1 || { echo 'NODE_UNAVAILABLE: caller root acceptance unverified' >&2; exit 4; }
  script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  node - "$script_dir" "$@" <<'ACCEPTANCE'
const fs=require('node:fs'),path=require('node:path'),cp=require('node:child_process'),crypto=require('node:crypto');
const [scripts,,run,...args]=process.argv.slice(2);
if(!run || (args.length && (args.length!==2 || args[0]!=='--tree'))){console.error('usage: report-status --acceptance RUN_MD [--tree FULL_GIT_TREE]');process.exit(2)}
const tree=args[1],pending=[],gaps=[],requirements=new Map(),snapshots=[],nonblockingFindings=[];
const text=v=>typeof v==='string'&&v.trim()!=='',hash=v=>typeof v==='string'&&/^(?:[0-9a-f]{40}|[0-9a-f]{64})$/.test(v);
const object=v=>v&&typeof v==='object'&&!Array.isArray(v);
const gap=s=>gaps.push(s),wait=s=>pending.push(s);
let input;try{input=fs.readFileSync(run,'utf8')}catch(e){console.error(e.message);process.exit(2)}
let approvals=false;
for(const line of input.split(/\r?\n/)){
 if(/^[A-Za-z][A-Za-z0-9-]*:/.test(line))approvals=line==='approvals:';
 if(!line.startsWith('- root-acceptance'))continue;
 try{
  if(!approvals||!line.startsWith('- root-acceptance · '))throw Error('outside approvals or malformed record');
  const r=JSON.parse(line.slice('- root-acceptance · '.length));
  if(!object(r)||r.version!==1||r.owner!=='super-auto'||!hash(r.sourceTree))throw Error('invalid source/owner/version');
  if(!Array.isArray(r.requirements)||!r.requirements.length)throw Error('missing acceptance requirements');
  for(const q of r.requirements){
   if(!object(q)||!text(q.id)||!text(q.owner)||!['review','measurement','human'].includes(q.kind))throw Error('invalid acceptance requirements');
   if(q.kind==='measurement'&&(!text(q.command)||!text(q.configuration)||typeof q.requiredLive!=='boolean'))throw Error('invalid measurement requirements');
   requirements.set(q.id,q);
  }
  for(const k of ['evidence','reviews','decisions','runFailures'])if(!Array.isArray(r[k]))throw Error('missing '+k);
  if(r.findingAcceptance!==undefined&&!Array.isArray(r.findingAcceptance))throw Error('invalid finding acceptance judgments');
  if(!object(r.recovery)||!Array.isArray(r.recovery.obligations)||!Array.isArray(r.recovery.gaps)||!object(r.checkEvidence)||!['records','gaps','requiredLiveChecks'].every(k=>Array.isArray(r.checkEvidence[k])))throw Error('missing producer obligations/check evidence');
  snapshots.push(r);
 }catch(e){gap('root acceptance record: '+e.message)}
}
const current=snapshots.at(-1);
// Review source is immutable provenance carried by Recovery's deferred transport,
// not a deferred measurement. Validate history as well as the current snapshot.
const reviewSources=new Map();
const isReviewSource=r=>object(r)&&(typeof r.id==='string'&&r.id.startsWith('review-source:')||object(r.data)&&Object.hasOwn(r.data,'reviewSource'));
for(const snapshot of snapshots)for(const r of snapshot.recovery.obligations.filter(isReviewSource)){
 const source=r.data?.reviewSource;
 if(r.version!==1||r.kind!=='deferred'||r.operation!=='record'||!text(r.reason)||!Array.isArray(r.evidence)||!r.evidence.length||!r.evidence.every(text)||
    !object(r.data)||Object.keys(r.data).length!==1||!object(source)||!text(source.invocationId)||!/^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/.test(source.invocationId)||
    r.id!=='review-source:'+source.invocationId||!hash(source.base)||!hash(source.head)){
  gap('invalid review-source provenance: '+(r.id||'unknown'));continue;
 }
 const old=reviewSources.get(source.invocationId);
 if(old&&(old.base!==source.base||old.head!==source.head))gap('conflicting review-source provenance: '+source.invocationId);
 else reviewSources.set(source.invocationId,source);
}
if(!current)gap('caller acceptance requirements unavailable');
else{
 if(tree!==undefined&&!hash(tree)){console.error('not a full Git tree identity');process.exit(2)}
 if(tree!==undefined&&tree!==current.sourceTree)gap('acceptance source differs from requested source tree');
 const records=snapshots.flatMap(r=>[...r.evidence,...r.checkEvidence.records]);
 const identity=r=>object(r)&&hash(r.sourceTree)&&text(r.command)&&text(r.configuration);
 const valid=r=>identity(r)&&text(r.location)&&['live','simulated','fallback'].includes(r.kind)&&['pass','fail','unavailable'].includes(r.outcome);
 for(const r of records)if(!valid(r))gap('invalid source-bound measurement evidence');
 function measure(q,label){
  if(!identity(q)){gap(label+': measurement identity unavailable');return false}
  const matches=records.filter(r=>valid(r)&&r.sourceTree===q.sourceTree&&r.command===q.command&&r.configuration===q.configuration&&(!q.id||!q.taskCheck||r.id===q.id)&&(!q.requiredLive||r.kind==='live'));
  // Contradictory outcomes at an immutable source do not silently turn into a pass.
  if(matches.some(r=>r.outcome==='pass')&&!matches.some(r=>r.outcome==='fail'))return true;
  const result=matches.some(r=>r.outcome==='fail')?'fail':matches.some(r=>r.outcome==='unavailable')?'unavailable':'unavailable'+(q.requiredLive?' (live required)':'');
  wait(label+': '+result+'; owner: '+(q.owner||'caller'));return false;
 }
 for(const kind of ['review','measurement','human'])if(![...requirements.values()].some(q=>q.kind===kind))gap('missing '+kind+' acceptance requirements');
 for(const q of requirements.values()){
  if(q.kind==='measurement')measure({...q,sourceTree:q.sourceTree||current.sourceTree},q.id);
  else if(q.kind==='review'){
   const review=current.reviews.filter(r=>r&&r.id===q.id).at(-1);
   if(!review||review.sourceTree!==current.sourceTree||review.outcome!=='pass'||!text(review.location))wait(q.id+': review pending; owner: '+q.owner);
  }else{
   const decision=current.decisions.filter(r=>r&&r.id===q.id).at(-1);
   if(!decision||decision.authority!=='human'||decision.decision!=='accept'||!Array.isArray(decision.evidence)||!decision.evidence.length||!decision.evidence.every(text))wait(q.id+': human decision pending; owner: '+q.owner);
  }
 }
 for(const r of snapshots)for(const q of r.checkEvidence.requiredLiveChecks)measure({...q,requiredLive:true,taskCheck:true},'required live check '+(q?.command||'unknown'));
 for(const g of [...current.recovery.gaps,...current.checkEvidence.gaps])gap(typeof g==='string'?g:JSON.stringify(g));
 const failures=new Map();
 for(const f of current.runFailures){
  if(!object(f)||!text(f.id)||!['run-introduced','pre-run','gap'].includes(f.classification)||!['open','verified'].includes(f.state)){gap('invalid run failure classification');continue}
  failures.set(f.id,f);
  for(const g of f.gaps||[])gap(f.id+': '+(typeof g==='string'?g:JSON.stringify(g)));
  if(f.classification==='pre-run')continue; // diagnostic repair status cannot erase attribution gaps
  if(f.classification==='gap'||f.state!=='verified')wait(f.id+': '+f.classification+' '+f.state+'; owner: '+(f.owner||'caller'));
 }
 for(const r of current.recovery.obligations){
  if(!object(r)||r.version!==1||!text(r.id)||!['hold','pending-closure','deferred'].includes(r.kind)||r.operation!=='record'||!text(r.reason)||!Array.isArray(r.evidence)||!r.evidence.length||!r.evidence.every(text)||!object(r.data)){gap('invalid recovery obligation');continue}
  if(isReviewSource(r))continue; // validated above, never invent command/configuration work
  if(r.data.runFailure){if(!failures.has(r.id))gap(r.id+': run failure classification unavailable');continue}
  if(r.kind==='deferred'){
   const binding=[...requirements.values()].find(q=>q.kind==='measurement'&&Array.isArray(q.obligations)&&q.obligations.includes(r.id));
   // Deferred final-suite records predate any tested tree. The caller explicitly binds
   // their exact IDs to the final measurement; a pass cannot clear another obligation.
   if(binding && (!r.data.command||r.data.command===binding.command) && (!r.data.configuration||r.data.configuration===binding.configuration) && (!r.data.sourceTree||r.data.sourceTree===(binding.sourceTree||current.sourceTree)))measure({...binding,sourceTree:binding.sourceTree||current.sourceTree,requiredLive:true},r.id);
   else measure({...r.data,requiredLive:true},r.id);
  }
  else wait(r.id+': '+r.kind+' '+r.reason+'; owner: '+(r.data.owner||'caller'));
 }
}
// The outer caller collects settled reports. The read-only gate reconciles known
// producer pointers with complete retained extraction, never ledger display keys.
const runDir=path.dirname(path.resolve(run)),sources=[],declared=new Map(),ledgers=[],correspondences=[];
const roastInputs={design:new Set(),code:new Set()};
const artifactPath=value=>{const resolved=path.resolve(runDir,value);try{return fs.realpathSync(resolved)}catch{return resolved}};
let inApprovals=false,fenced=false;
for(const line of input.split(/\r?\n/)){
 if(/^\s*(```|~~~)/.test(line)){fenced=!fenced;continue}if(fenced)continue;
 if(/^[A-Za-z][A-Za-z0-9-]*:/.test(line))inApprovals=line==='approvals:';
 if(inApprovals&&line.startsWith('- finding-source · ')){
  try{const s=JSON.parse(line.slice('- finding-source · '.length));if(object(s)&&text(s.source)&&text(s.artifact))sources.push(s)}catch{}
 }
 if(line.startsWith('- source-correspondence')){
  try{
   if(!inApprovals||!line.startsWith('- source-correspondence · '))throw Error();
   correspondences.push(JSON.parse(line.slice('- source-correspondence · '.length)));
  }catch{gap('source coverage: malformed source-correspondence record')}
 }
 const report=line.match(/^(roast-design|roast-code):\s*(.*)$/);
 if(report)for(const artifact of report[2].split(',').map(s=>s.trim())){
  if(!artifact)gap('source coverage: empty '+report[1]+' report pointer');
  else{const original=artifactPath(artifact);declared.set(original,'roast');roastInputs[report[1].slice(6)].add(original)}
 }
 const ledger=line.match(/^(findingsLedgerDesign|findingsLedger):\s*(.*)$/);
 if(ledger)ledgers.push({artifact:ledger[2].trim(),loop:ledger[1]==='findingsLedgerDesign'?'design':'code'});
}
const repo=cp.spawnSync('git',['-C',runDir,'rev-parse','--show-toplevel'],{encoding:'utf8'});
const repoDir=repo.status===0?repo.stdout.trim():null;
const ledgerKeys=new Map();
for(const {artifact,loop} of ledgers){
 try{
  if(!artifact)throw Error('empty ledger pointer');
  const lines=fs.readFileSync(path.resolve(runDir,artifact),'utf8').trimEnd().split(/\r?\n/);
  if(!new RegExp('^# findings ledger — '+loop+' — through r[0-9]+$').test(lines[0])||!/^triggers: .+/.test(lines[1]||'')||
     !/^blocking: .+/.test(lines[2]||'')||!/^ignored-overrides: [0-9]+$/.test(lines[3]||''))throw Error('malformed ledger header');
  // Headers contain no total finding count/input manifest: zero rows can mean
  // truncation even with zero Blocking. Only the caller declares the input set.
  if(!roastInputs[loop].size)gap('source coverage: ledger input population unavailable: '+artifact+'; declare all roast-'+loop+' producer inputs');
  if(!lines.slice(4).some(line=>line.trim())&&/\br[0-9]+=[1-9][0-9]*(?:\s|$)/.test(lines[2]))gap('source coverage: ledger header contradicts missing finding rows: '+artifact);
  const rowKeys=new Set();
  for(const [index,line] of lines.slice(4).entries()){
   if(!line.trim())continue;
   const row=line.match(/^- (\[[^\]]+\] .+) · raised r[0-9]+@(?:[a-f0-9]+|-) · .+ · source (roast|final-review) · text (.+)$/);
   if(!row){gap('source coverage: malformed ledger row '+artifact+':'+(index+5));continue}
   rowKeys.add(row[1]);
   // The producer preserves its input path. Accept a run-relative or repo-relative
   // path only when it selects one unambiguous original file, never by basename/key.
   const candidates=[...new Set([artifactPath(row[3]),...(repoDir?[artifactPath(path.resolve(repoDir,row[3]))]:[])])].filter(p=>fs.existsSync(p));
   if(candidates.length!==1){gap('source coverage: unavailable or ambiguous ledger report '+artifact+':'+(index+5)+' '+row[3]);continue}
   const kind=row[2]==='final-review'?'keys':'roast';
   const cacheKey=JSON.stringify([candidates[0],kind]);
   if(!ledgerKeys.has(cacheKey)){
    if(kind==='keys')ledgerKeys.set(cacheKey,fs.readFileSync(candidates[0],'utf8').split(/\r?\n/).map(k=>k.trim().replace(/^r[0-9]+\s+/,'')));
    else{
     const keys=cp.spawnSync('bash',[path.resolve(scripts,'../../super-code/scripts/report-verdict'),'--keys',candidates[0]],{encoding:'utf8'});
     ledgerKeys.set(cacheKey,keys.status===0?keys.stdout.split(/\r?\n/):null);
    }
   }
   // Key membership checks the ledger producer's pointer transport only. It never
   // identifies, links or resolves occurrences; complete source/ref checks follow.
   if(!ledgerKeys.get(cacheKey)?.includes(row[1]))gap('source coverage: inconsistent ledger key/report pointer '+artifact+':'+(index+5));
   if(declared.has(candidates[0])&&declared.get(candidates[0])!==kind)gap('source coverage: conflicting report kind '+candidates[0]);
   else declared.set(candidates[0],kind);
  }
  // Reverse transport check catches missing rows of every severity. Equal keys
  // still do not identify occurrences: all declared original reports are separately
  // extracted and their immutable refs retain independent relevance/dispositions.
  for(const original of roastInputs[loop]){
   const cacheKey=JSON.stringify([original,'roast']);
   if(!ledgerKeys.has(cacheKey)){
    const keys=cp.spawnSync('bash',[path.resolve(scripts,'../../super-code/scripts/report-verdict'),'--keys',original],{encoding:'utf8'});
    ledgerKeys.set(cacheKey,keys.status===0?keys.stdout.split(/\r?\n/):null);
   }
   const keys=ledgerKeys.get(cacheKey);
   if(keys===null)gap('source coverage: ledger declared input population unavailable: '+artifact+'; '+original);
   else if(keys.some(key=>key.trim()&&!rowKeys.has(key)))gap('source coverage: ledger population incomplete for declared report: '+artifact+'; '+original);
  }
 }catch(e){gap('source coverage: declared ledger '+artifact+': '+e.message)}
}
const extractor=path.resolve(scripts,'../../super-code/scripts/report-verdict');
const content=r=>JSON.stringify([r.version,r.source,r.kind,r.verdict,r.occurrences]);
const extract=(artifact,source)=>cp.spawnSync('bash',[extractor,'--complete','--source',source,artifact],{encoding:'utf8'});
const sha=artifact=>crypto.createHash('sha256').update(fs.readFileSync(artifact)).digest('hex');
const refId=r=>JSON.stringify([r?.source,r?.section,r?.position]);
const associated=new Map();
for(const association of correspondences){
 try{
  const a=association;
  if(!object(a)||a.version!==1||!text(a.artifact)||!text(a.source)||!text(a.retainedArtifact)||!(/^[a-f0-9]{64}$/).test(a.sha256)||!(/^[a-f0-9]{64}$/).test(a.retainedSha256)||
     a.judgment!=='supported'||!text(a.basis)||!Array.isArray(a.evidence)||!a.evidence.length||!a.evidence.every(text))throw Error('unsupported or malformed association');
  const original=artifactPath(a.artifact),retained=artifactPath(a.retainedArtifact),kind=declared.get(original);
  if(!kind)throw Error('association does not name a declared original input');
  if(sha(original)!==a.sha256||sha(retained)!==a.retainedSha256)throw Error('original or retained hash mismatch');
  const matches=sources.filter(s=>s.source===a.source&&artifactPath(s.artifact)===retained);
  const result=extract(retained,a.source);
  if(!matches.length||result.status!==0)throw Error('retained source extraction unavailable');
  const actual=JSON.parse(result.stdout);
  if(matches.some(s=>content(s)!==content(actual)))throw Error('retained source differs from complete extraction');
  if(kind==='keys'){
   if(actual.kind!=='final-review'||!Array.isArray(a.lines))throw Error('keys input needs final-review source and complete line correspondence');
   const lines=fs.readFileSync(original,'utf8').split(/\r?\n/),keyLines=[];
   for(const [i,line] of lines.entries()){
    if(i===0&&/^review: (ready|not ready|none)$/.test(line))continue;
    if(!line.trim())continue;
    if(!/^(?:r[0-9]+ )?\[Must-fix\] .+/.test(line))throw Error('malformed keys input');
    keyLines.push(i+1);
   }
   if(!keyLines.length)throw Error('ledger row points at empty keys input');
   const known=new Set(actual.occurrences.map(o=>refId({source:a.source,...o}))),seen=new Set();
   for(const mapping of a.lines){
    if(!object(mapping)||!Number.isSafeInteger(mapping.line)||!keyLines.includes(mapping.line)||seen.has(mapping.line)||
       !Array.isArray(mapping.refs)||!mapping.refs.length||mapping.refs.some(r=>!object(r)||r.source!==a.source||!known.has(refId(r))))throw Error('invalid keys line occurrence correspondence');
    seen.add(mapping.line);
   }
   if(seen.size!==keyLines.length)throw Error('incomplete keys line correspondence');
  }else{
   if(actual.kind!==kind)throw Error('retained report kind differs from declaration');
   const raw=extract(original,a.source);
   if(a.sha256===a.retainedSha256){if(raw.status!==0||content(JSON.parse(raw.stdout))!==content(actual))throw Error('original report extraction mismatch')}
   else{
    // Adapters are reviewed interpretations of malformed historical reports. Never
    // convert an ordinary valid source or restamp the original historical verdict.
    const interpretation=a.interpretation;
    if(raw.status===0||!object(interpretation)||interpretation.kind!=='legacy-adapter'||!text(interpretation.originalVerdict)||
       !Array.isArray(interpretation.limitations)||!interpretation.limitations.length||!interpretation.limitations.every(text))throw Error('legacy adapter requires retained interpretation limitations and original extraction failure');
    const compact=cp.spawnSync('bash',[extractor,original],{encoding:'utf8'});
    const verdict=compact.stdout?.split('\n').find(l=>l.startsWith('verdict: '))?.slice(9),originalKind=compact.stdout?.split('\n').find(l=>l.startsWith('kind: '))?.slice(6);
    if(compact.status!==0||originalKind!==actual.kind||verdict!==actual.verdict||interpretation.originalVerdict!==verdict)throw Error('adapter changes or lacks original historical kind/verdict');
   }
  }
  const binding=JSON.stringify([a.sha256,a.source,a.retainedSha256,a.lines||null]);
  if(associated.has(original)&&associated.get(original)!==binding)throw Error('conflicting immutable source correspondence');
  associated.set(original,binding);
 }catch(e){gap('source coverage: source-correspondence '+(association?.artifact||'unknown')+': '+e.message)}
}
for(const [artifact,kind] of declared){
 if(associated.has(artifact))continue;
 if(kind==='keys'){gap('source coverage: keys-only ledger input needs supported original-source correspondence: '+artifact);continue}
 const matches=sources.filter(s=>artifactPath(s.artifact)===artifact);
 if(!matches.length){gap('source coverage: declared report has no retained source extraction: '+artifact);continue}
 for(const s of matches){
  const extracted=extract(artifact,s.source);
  try{
   if(extracted.status!==0)throw Error('original report unavailable or malformed');
   const actual=JSON.parse(extracted.stdout);
   if(actual.kind!==kind||content(actual)!==content(s))throw Error('retained extraction differs from complete original report');
  }catch(e){gap('source coverage: '+artifact+' ('+s.source+'): '+e.message)}
 }
}
// Use the same validated projection as Remaining and resume. Valid empty is distinct
// from a missing extraction or an empty --keys stream carrying gaps.
const projection=cp.spawnSync('bash',[path.join(scripts,'scope-dispositions'),'--project',run],{encoding:'utf8'});
try{
 if(![0,3].includes(projection.status))throw Error('unavailable');
 const p=JSON.parse(projection.stdout);if(!Array.isArray(p.findings)||!Array.isArray(p.gaps))throw Error('malformed');
 for(const g of p.gaps)gap('finding evidence: '+JSON.stringify(g));
 const sameRef=(a,b)=>a&&b&&a.source===b.source&&a.section===b.section&&a.position===b.position;
 for(const f of p.findings.filter(f=>f.outstanding)){
  const refs=f.occurrences.map(o=>({source:o.source,section:o.section,position:o.position}));
  // Explicit projection links establish one finding group. Assess it once through
  // any exact member ref, retaining every original source occurrence in the result.
  const judgment=(current?.findingAcceptance||[]).filter(j=>refs.some(ref=>sameRef(j?.ref,ref))).at(-1);
  if(!judgment||judgment.judgment!=='supported'||!text(judgment.basis)||!Array.isArray(judgment.evidence)||!judgment.evidence.length||!judgment.evidence.every(text)||!['required','nonblocking'].includes(judgment.effect))gap('finding acceptance relevance unproven: '+JSON.stringify(refs));
  else if(judgment.effect==='required'){
   if(!text(judgment.requirement)||!requirements.has(judgment.requirement))gap('finding acceptance requirement unavailable: '+JSON.stringify(refs));
   wait('finding '+JSON.stringify(refs)+' remains required for '+(judgment.requirement||'unknown acceptance'));
  }else nonblockingFindings.push(...refs); // still outstanding in the shared punch-list projection
 }
}catch{gap('finding projection unavailable')}
// Reuse ordinary status collection validation without recursively running this gate.
const status=cp.spawnSync('bash',[path.join(scripts,'report-status'),run],{encoding:'utf8',env:{...process.env,RS_SKIP_ACCEPTANCE:'1'}});
if(status.status!==0)gap('run status unavailable');
else for(const line of status.stdout.split('\n'))if(/^qualifier: (review collection|review collections|finding evidence|finding projection)/.test(line))gap(line.slice(11));
const result={owner:'super-auto',sourceTree:current?.sourceTree||null,eligible:pending.length===0&&gaps.length===0,pending:[...new Set(pending)],gaps:[...new Set(gaps)],nonblockingFindings};
// Keep the event loop alive until stdout drains; failed output is not acceptance.
process.exitCode=result.eligible?0:3;
process.stdout.on('error',error=>{
 console.error('acceptance output failed: '+error.message);
 process.exitCode=1;
});
console.log(JSON.stringify(result));
ACCEPTANCE
  exit $?
fi

# Collection writes only after the caller has confirmed this invocation settled. Launch
# intent records (settled:false) remain visible until that confirmation; file presence alone
# cannot establish settlement. Ordinary status mode below remains read-only.
if [ "${1:-}" = --collect ]; then
  command -v node >/dev/null 2>&1 || { echo 'NODE_UNAVAILABLE: retain source bundles; collection is unverified' >&2; exit 4; }
  script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  node - "$script_dir" "$@" <<'COLLECT'
const fs=require('node:fs'), path=require('node:path'), crypto=require('node:crypto'), cp=require('node:child_process');
