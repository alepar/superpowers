#!/usr/bin/env bash
# The report.md status line for one super-auto run, computed from its run.md. This script is the
# only source of the status line and its degraded qualifiers; paste its output verbatim.
#
#   report-status RUN_MD [--tip SHA] [--stalled PHASE]
#
# RUN_MD: the run's run.md (fields per run-state.md). --tip SHA: the run branch's HEAD, the commit
# the report describes; every report-prompt.md call passes it, and without it a sweep's stamp is
# still required but not compared. A stamp other than SHA is still at the tip when `git diff` finds
# no change between the two commits outside RUN_MD's directory, the run directory that phase 6
# commits run.md, friction.md and report.md into after the sweep; a git failure counts as a change.
# --stalled PHASE: the orchestrator judged the run stalled at
# PHASE, a state run.md cannot carry.
#
# Status, first match wins:
#   --stalled PHASE                         -> status: stalled at phase PHASE
#   phase: capped-blocking                  -> status: stalled at phase capped-blocking
#   codeBuckets.stalled true                -> status: stalled at phase code
#   N > 0, M > 0 or pendingRetry non-empty  -> status: completed with N unresolved Blocking, M escalations
#   otherwise                               -> status: clean
# The two non-stalled forms take ` [degraded: q1, q2, ...]` when any qualifier applies.
# N: finding keys in `roastCodeCapped:` plus, unless it ends `stopped`, in `roastDesignCapped:`.
# M: parked `escalation` records plus ids in codeBuckets.escalated.
#
# Fields read, each with its writer and what its absent or other form gives:
#   flags (skipPlanRoast, skipCodeRoast): SKILL.md §Pre-flight step 4. No line, or a key missing: exit 2.
#   phase: SKILL.md §Who writes run.md. No line, or not a run-state.md token: exit 2.
#   parked: super-design (phases 1-2), super-auto (phase 3 on). Absent: no records. A
#     `degraded-verdict` record may end ` · resolves-on: sweep`.
#   roastDesignCapped: super-design §Adversarial Review Loop (root only). Absent: nothing; a last
#     slot other than `stopped` counts as `proceeded`.
#   roastCodeCapped: SKILL.md §Cap disposition, on a cap or thrash exit with Blocking open. Absent: nothing.
#   codeBuckets: run-state.md item 6 at each phase 3->4 transition and re-entry; `sweep` rewritten by
#     SKILL.md §Phase 6 — report steps 1 and 2. No block at phase report, finish or done: `final
#     review: none recorded` and `sweep: none recorded`; no block earlier: nothing. A bucket line
#     missing from the block: `<bucket> bucket: none recorded` (review and sweep: their own
#     `none recorded` forms).
#
# Qualifiers, in this order, each once: `design roast capped-blocking` (roastDesignCapped not
# stopped); each parked `degraded-verdict` record's qualifier (the bracketed text in its part before
# ` — `, else that part), skipped for a ` · resolves-on: sweep` record when --tip is given and the
# sweep is a stamped pass at the tip (the sweep rules below give it no qualifier); `plan roast
# skipped` / `code roast skipped` (flags); then the codeBuckets ones: missing-bucket qualifiers,
# `code findings parked` (parked non-empty), `tasks pending retry` (pendingRetry non-empty),
# `final review: <review>` (review not `CLEAN` or `ready`, so the `<verdict> (<N> confirmed)` and
# `not ready (<summary>)` forms; `none recorded` when empty), then the sweep:
#   `sweep: <sweep>`              it is not a pass: it carries a failing signal (a non-zero failed
#                                 or errors count, FAIL, DEFERRED, INVALID, UNAVAILABLE) or lacks
#                                 the pass form `<P> passed, 0 failed, 0 errors`;
#   `sweep: unstamped — <sweep>`  a pass with no ` @ <sha>` stamp;
#   `sweep: not at tip — <sweep>` a pass whose stamp is not --tip and differs from it outside the
#                                 run directory.
#
# Prints the status line, then one `qualifier: <text>` line per qualifier, in the order above.
# Bash and awk, plus git only to compare a sweep stamp with --tip: needs no jq, so it never prints
# JQ_UNAVAILABLE.
# Ordinary status: exit 0 ok, 2 bad input; legacy records require only Bash/awk.
# Additive finding/collection records use Node for the shared projection; unavailability
# is an explicit qualifier. --collect is the settled-bundle write mode (usage below):
# exit 0 preserved, 3 evidence gaps, 2 bad input, 4 Node unavailable.
set -euo pipefail

# Collection writes only after the caller has confirmed this invocation settled. Launch
# intent records (settled:false) remain visible until that confirmation; file presence alone
# cannot establish settlement. Ordinary status mode below remains read-only.
if [ "${1:-}" = --collect ]; then
  command -v node >/dev/null 2>&1 || { echo 'NODE_UNAVAILABLE: retain source bundles; collection is unverified' >&2; exit 4; }
  script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  node - "$script_dir" "$@" <<'COLLECT'
const fs=require('node:fs'), path=require('node:path'), crypto=require('node:crypto'), cp=require('node:child_process');
const [scriptDir,,run,...args]=process.argv.slice(2);
const usage=()=>{console.error('usage: report-status --collect RUN_MD [--invocation ID --workspace DIR --review FILE|none --verdict TEXT [--required RELATIVE_FILE]...]');process.exit(2)};
if(!run)usage();
const o={},required=[];
for(let i=0;i<args.length;i+=2){if(!args[i+1])usage();if(args[i]==='--required')required.push(args[i+1]);else if(['--invocation','--workspace','--review','--verdict'].includes(args[i])&&!o[args[i]])o[args[i]]=args[i+1];else usage();}
let text;try{text=fs.readFileSync(run,'utf8')}catch(e){console.error(e.message);process.exit(2)}
const dir=path.dirname(path.resolve(run)), latest=new Map();let approvals=false;
function append(type,data){const line='- '+type+' · '+JSON.stringify(data);const prior=text.split('\n');if(type==='review-collection'){const previous=prior.filter(l=>{try{return l.startsWith('- review-collection · ')&&JSON.parse(l.slice('- review-collection · '.length)).invocationId===data.invocationId}catch{return false}}).at(-1);if(previous===line)return}else if(prior.includes(line))return;const lines=text.trimEnd().split('\n');let start=lines.indexOf('approvals:');if(start<0){lines.push('approvals:');start=lines.length-1}let end=start+1;while(end<lines.length&&!/^[A-Za-z][A-Za-z0-9-]*:/.test(lines[end]))end++;lines.splice(end,0,line);text=lines.join('\n')+'\n';const pending=run+'.collection-tmp-'+process.pid;fs.writeFileSync(pending,text);fs.renameSync(pending,run);}
const validCollection = r => r && /^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/.test(r.invocationId) &&
 typeof r.workspace==='string' && path.isAbsolute(r.workspace) &&
 (r.reviewPath===null || (typeof r.reviewPath==='string' && path.isAbsolute(r.reviewPath))) &&
 typeof r.review==='string' && r.review.trim()!=='' && typeof r.settled==='boolean' &&
 Array.isArray(r.required) && r.required.every(f=>typeof f==='string' && f!=='' && !path.isAbsolute(f) && !f.split(/[\\/]/).includes('..')) &&
 (r.complete===undefined || typeof r.complete==='boolean') &&
 (r.gaps===undefined || (Array.isArray(r.gaps) && r.gaps.every(g=>typeof g==='string' && g!==''))) &&
 (r.files===undefined || (Array.isArray(r.files) && r.files.every(f=>f && typeof f.path==='string' && f.path!=='' && !path.isAbsolute(f.path) && !f.path.split(/[\\/]/).includes('..') && /^[a-f0-9]{64}$/.test(f.sha256)))) &&
 (!r.complete || (r.settled && Array.isArray(r.gaps) && r.gaps.length===0 &&
 (r.reviewPath===null ? r.review==='no work landed' : r.files?.some(f=>f.path==='final-review-'+r.invocationId+'.md'))));
let malformed=false;
for(const line of text.split('\n')){if(/^[A-Za-z][A-Za-z0-9-]*:/.test(line))approvals=line==='approvals:';if(!line.startsWith('- review-collection'))continue;try{if(!approvals||!line.startsWith('- review-collection · '))throw Error();const r=JSON.parse(line.slice('- review-collection · '.length));if(!validCollection(r))throw Error();latest.set(r.invocationId,r)}catch{malformed=true}}
if(args.length){if(Object.keys(o).length!==4||!/^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/.test(o['--invocation']))usage();const r={invocationId:o['--invocation'],workspace:path.resolve(o['--workspace']),reviewPath:o['--review']==='none'?null:path.resolve(o['--review']),review:o['--verdict'],required,settled:true};const old=latest.get(r.invocationId);if(old&&(old.workspace!==r.workspace||(old.reviewPath!==r.reviewPath&&(old.settled||r.reviewPath!==null))||JSON.stringify(old.required)!==JSON.stringify(r.required))){append('review-collection',{...old,complete:false,gaps:['invocation identity or required bundle changed; retain both sources']});console.error('COLLECTION_GAP: invocation identity or required bundle changed; retain both sources');process.exit(3)}if(!old||!old.settled){append('review-collection',r);latest.set(r.invocationId,r)}}
const hash=f=>crypto.createHash('sha256').update(fs.readFileSync(f)).digest('hex');
const hasBundle=(r,id)=>{const p='final-review-'+id;try{return fs.readdirSync(r.workspace).some(n=>n===p+'.md'||n===p+'.diff'||n.startsWith(p+'.cluster-'))||fs.existsSync(path.join(r.workspace,'assembled',p+'-final'))}catch{return false}};
let gaps=malformed?1:0;if(malformed)console.error('COLLECTION_GAP: malformed collection record; retain sources');
for(const previous of latest.values()){
 const r={...previous},id=r.invocationId,prefix='final-review-'+id,archive=path.join(dir,'reviews',id), problems=[];
 const gap=m=>{if(!problems.includes(m))problems.push(m)};
 if(!r.settled){gap('invocation settlement unverified; inspect Launch and completion before collection')}
 else if(r.reviewPath===null&&!hasBundle(r,id)){if(r.review!=='no work landed')gap('required review is null; owner: orchestrator; recover whole-epic review')}
 else{
  const expected=path.join(r.workspace,prefix+'.md');
  if(r.reviewPath===null)gap('null review has recoverable bundle artifacts; reconcile returned result');
  else if(path.resolve(r.reviewPath)!==path.resolve(expected))gap('reviewPath does not match persisted invocation');
  const files=new Set(r.required);
  function walk(relative){const full=path.join(r.workspace,relative);try{const st=fs.lstatSync(full);if(st.isSymbolicLink())throw Error('symlink');if(st.isDirectory())for(const name of fs.readdirSync(full).sort())walk(path.join(relative,name));else if(st.isFile())files.add(relative);else throw Error('not a regular file')}catch(e){gap('bundle unavailable: '+relative)}}
  files.add(prefix+'.md');
  try{for(const name of fs.readdirSync(r.workspace).sort())if(name===prefix+'.diff'||(name.startsWith(prefix+'.cluster-')&&/^\d+\.md$/.test(name.slice((prefix+'.cluster-').length))))files.add(name)}catch{if(!previous.complete)gap('workspace unavailable: '+r.workspace)}
  const assembled=path.join('assembled',prefix+'-final');
  if(fs.existsSync(path.join(r.workspace,assembled)))walk(assembled);
  const clusters=[...files].filter(f=>f.startsWith(prefix+'.cluster-'));
  if(clusters.length){try{const m=JSON.parse(fs.readFileSync(path.join(r.workspace,assembled,'clusters.json'),'utf8'));if(!Array.isArray(m.clusters)||!m.clusters.length)throw Error();for(const [n,c]of m.clusters.entries()){files.add(prefix+'.cluster-'+(n+1)+'.md');if(!Array.isArray(c.slices))throw Error();for(const slice of c.slices)files.add(path.join(assembled,slice))}}catch{gap('split bundle manifest unavailable or incomplete')}}
  // A completed archive remains usable after the source worktree is intentionally removed.
  if(previous.complete&&Array.isArray(previous.files))for(const f of previous.files)files.add(f.path);
  const manifests=[];
  for(const rel of [...files].sort()){
   if(typeof rel!=='string'||path.isAbsolute(rel)||rel.split(/[\\/]/).some(p=>p==='..')||rel===''){gap('unsafe bundle path');continue}
   const src=path.join(r.workspace,rel),dst=path.join(archive,rel),saved=previous.files?.find(f=>f.path===rel);
   let srcHash=null,dstHash=null;try{if(!fs.lstatSync(src).isFile()||fs.lstatSync(src).isSymbolicLink())throw Error();srcHash=hash(src)}catch{}
   try{if(!fs.lstatSync(dst).isFile()||fs.lstatSync(dst).isSymbolicLink())throw Error();dstHash=hash(dst)}catch{}
   if((rel===prefix+'.md'||clusters.includes(rel)||/^final-review-.*\.cluster-\d+\.md$/.test(rel))&&srcHash){
    const logical=rel===prefix+'.md'?'final':rel.slice(prefix.length+1,-3);
    const result=cp.spawnSync('bash',[path.resolve(scriptDir,'../../super-code/scripts/report-verdict'),'--complete','--source',id+'/'+logical,src],{encoding:'utf8'});
    try{if(result.status!==0)throw Error();const source=JSON.parse(result.stdout);source.artifact=path.relative(dir,dst);append('finding-source',source)}catch{gap('complete extraction unavailable: '+rel)}
   }
   if(srcHash&&dstHash&&srcHash!==dstHash){gap('archive conflict: '+rel);continue}
   if(saved&&dstHash&&saved.sha256!==dstHash){gap('archive integrity mismatch: '+rel);continue}
   if(!dstHash&&srcHash){try{fs.mkdirSync(path.dirname(dst),{recursive:true});fs.copyFileSync(src,dst,fs.constants.COPYFILE_EXCL);dstHash=hash(dst)}catch{gap('archive copy failed: '+rel)}}
   if(!dstHash||(!srcHash&&(!previous.complete||!saved))){gap('bundle unavailable: '+rel);continue}
   manifests.push({path:rel,sha256:dstHash});
  }
  r.files=manifests;
 }
 r.complete=problems.length===0;r.gaps=problems;
 append('review-collection',r);
 if(problems.length){gaps+=problems.length;for(const p of problems)console.error('COLLECTION_GAP: '+id+': '+p+'; keep source workspace and archive; owner: orchestrator')}
}
console.log(gaps?'collection: gaps — retain sources; block later invocation and cleanup':'collection: complete');process.exit(gaps?3:0);
COLLECT
  exit $?
fi

usage() { echo "usage: report-status RUN_MD [--tip SHA] [--stalled PHASE]" >&2; exit 2; }
run='' stalled='' tip=''
while [ $# -gt 0 ]; do
  case "$1" in
    --stalled) [ $# -ge 2 ] || usage; stalled=$2; shift 2 ;;
    --tip) [ $# -ge 2 ] || usage; tip=$2; shift 2 ;;
    -*) usage ;;
    *) [ -z "$run" ] || usage; run=$1; shift ;;
  esac
done
[ -n "$run" ] || usage
[ -f "$run" ] || { echo "run.md not found: $run" >&2; exit 2; }
case "$stalled" in
  ''|design|roast-design|capped-blocking|code|roast-code|fix-loop|report|finish) ;;
  *) echo "not a stallable phase: $stalled" >&2; exit 2 ;;
esac
[ -z "$tip" ] || [[ "$tip" =~ ^[0-9a-f]{7,40}$ ]] || { echo "not a commit SHA: $tip" >&2; exit 2; }
rundir=$(CDPATH= cd -- "$(dirname -- "$run")" && pwd)

continuity=''
if awk '/^- (finding-|review-collection)/ { found=1; exit } END { exit !found }' "$run"; then
  if command -v node >/dev/null 2>&1; then
    script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    continuity=$(node - "$script_dir" "$run" <<'STATUS'
const fs=require('node:fs'),path=require('node:path'),cp=require('node:child_process');
const [scripts,run]=process.argv.slice(2),text=fs.readFileSync(run,'utf8'),latest=new Map();let errors=0,block=false;
const validCollection = r => r && /^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/.test(r.invocationId) &&
 typeof r.workspace==='string' && path.isAbsolute(r.workspace) &&
 (r.reviewPath===null || (typeof r.reviewPath==='string' && path.isAbsolute(r.reviewPath))) &&
 typeof r.review==='string' && r.review.trim()!=='' && typeof r.settled==='boolean' &&
 Array.isArray(r.required) && r.required.every(f=>typeof f==='string' && f!=='' && !path.isAbsolute(f) && !f.split(/[\\/]/).includes('..')) &&
 (r.complete===undefined || typeof r.complete==='boolean') &&
 (r.gaps===undefined || (Array.isArray(r.gaps) && r.gaps.every(g=>typeof g==='string' && g!==''))) &&
 (r.files===undefined || (Array.isArray(r.files) && r.files.every(f=>f && typeof f.path==='string' && f.path!=='' && !path.isAbsolute(f.path) && !f.path.split(/[\\/]/).includes('..') && /^[a-f0-9]{64}$/.test(f.sha256)))) &&
 (!r.complete || (r.settled && Array.isArray(r.gaps) && r.gaps.length===0 &&
 (r.reviewPath===null ? r.review==='no work landed' : r.files?.some(f=>f.path==='final-review-'+r.invocationId+'.md'))));
for(const l of text.split('\n')){if(/^[A-Za-z][A-Za-z0-9-]*:/.test(l))block=l==='approvals:';if(l.startsWith('- review-collection'))try{if(!block||!l.startsWith('- review-collection · '))throw Error();const r=JSON.parse(l.slice('- review-collection · '.length));if(!validCollection(r))throw Error();latest.set(r.invocationId,r)}catch{errors++}}
let pending=0;for(const r of latest.values()){if(!r.complete)pending++;errors+=(r.gaps||[]).length}
if(pending)console.log('review collections pending: '+pending);
if(errors)console.log('review collection gaps: '+errors);
if(/^- finding-/m.test(text)){
 const p=cp.spawnSync('bash',[path.join(scripts,'scope-dispositions'),'--project',run],{encoding:'utf8'});
 try{if(![0,3].includes(p.status))throw Error();const d=JSON.parse(p.stdout),n=d.findings.filter(f=>f.outstanding).length;if(n)console.log('outstanding findings: '+n);if(d.gaps.length)console.log('finding evidence gaps: '+d.gaps.length)}catch{console.log('finding projection unavailable — retain known findings')}
}else if([...latest.values()].some(r=>r.reviewPath!==null))console.log('finding evidence gaps: source extraction unavailable');
STATUS
)
  else
    continuity='finding projection unavailable — retain known findings; review collection unverified'
  fi
fi

RS_CONTINUITY=$continuity RS_RUNDIR=$rundir awk -v stalled="$stalled" -v tip="$tip" '
  function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
  function truthy(v) { v = tolower(trim(v)); return v == "true" || v == "t" || v == "yes" || v == "1" }
  function isempty(v) { v = tolower(trim(v)); return v == "" || v == "none" || v == "-" }
  function after(s, label) { return trim(substr(s, length(label) + 1)) }
  function countids(v,   n, p, i, c) {
    if (isempty(v)) return 0
    n = split(v, p, ","); c = 0
    for (i = 1; i <= n; i++) if (trim(p[i]) != "") c++
    return c
  }
  # Finding keys (`[SEV] <loc>` or `rN [SEV] <loc>`) may hold commas: count one per key start.
  function countkeys(v,   s, c) {
    if (isempty(v)) return 0
    if (index(v, "[") == 0) return countids(v)
    s = "," v; c = 0
    while (match(s, /,[ \t]*(r[0-9]+ )?\[/)) { c++; s = substr(s, RSTART + RLENGTH) }
    return c
  }
  function addq(q) { q = trim(q); if (q != "" && !(q in seenq)) { seenq[q] = 1; qs[++nq] = q } }
  # The qualifier sits in the part before ` — `; the free-text tail may hold brackets of its own.
  function verdictq(t,   i) {
    t = trim(t); sub(/^"/, "", t); sub(/"$/, "", t)
    i = index(t, " — "); if (i) t = substr(t, 1, i - 1)
    if (match(t, /\[[^]]*\]/)) return substr(t, RSTART + 1, RLENGTH - 2)
    return t
  }
  # True when commits a and b differ only inside the run directory (RS_RUNDIR, the directory
  # holding RUN_MD). Any git failure, such as a SHA that does not resolve, counts as a difference.
  function codesame(a, b) {
    return system("git -C \"$RS_RUNDIR\" diff --quiet " a " " b " -- \":/\" \":(exclude).\" > /dev/null 2>&1") == 0
  }
  function sweepq(s,   sha) {
    if (s == "") return "sweep: none recorded"
    if (s ~ /(^|[^0-9])0*[1-9][0-9]* (failed|errors)/ || s ~ /FAIL|DEFERRED|INVALID|UNAVAILABLE/) return "sweep: " s
    if (s !~ /(^|[^0-9])[0-9]+ passed, 0+ failed, 0+ errors/) return "sweep: " s
    if (!match(s, /@[ \t]*[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]+/)) return "sweep: unstamped — " s
    sha = substr(s, RSTART + 1, RLENGTH - 1); sub(/^[ \t]+/, "", sha)
    if (tip != "" && index(tip, sha) != 1 && index(sha, tip) != 1 && !codesame(sha, tip)) return "sweep: not at tip — " s
    return ""
  }
  { sub(/\r$/, "") }
  /^[^ \t-]/ { block = "" }
  /^flags:/ {
    haveflags = 1
    n = split(after($0, "flags:"), f, /[ \t]+/)
    for (i = 1; i <= n; i++) if (split(f[i], kv, "=") == 2) flag[kv[1]] = kv[2]
    next
  }
  /^phase:/ { phase = after($0, "phase:"); sub(/[ \t]*\(skipped\)$/, "", phase); next }
  /^parked:/ { block = "parked"; next }
  /^codeBuckets:/ { block = "cb"; havecb = 1; next }
  /^roastDesignCapped:/ {
    n = split(after($0, "roastDesignCapped:"), p, / · /)
    if (n < 2 || trim(p[n]) !~ /^stopped/) { dcapped = 1; blocking += countkeys(p[1]) }
    next
  }
  /^roastCodeCapped:/ { split(after($0, "roastCodeCapped:"), p, / · /); blocking += countkeys(p[1]); next }
  block == "parked" && /^[ \t]*- / {
    n = split($0, p, / · /)
    res = (n > 3 && trim(p[n]) ~ /^resolves-on:[ \t]*sweep$/)
    if (res) n--
    kind = trim(p[2]); text = p[3]
    for (i = 4; i <= n; i++) text = text " · " p[i]
    if (kind == "escalation") esc++
    else if (kind == "degraded-verdict") { dv[++ndv] = verdictq(text); dvsweep[ndv] = res }
    next
  }
  block == "cb" && /^[ \t]+[A-Za-z]+:/ {
    line = trim($0); k = substr(line, 1, index(line, ":") - 1)
    cb[k] = after(line, k ":"); hascb[k] = 1
    next
  }
  END {
    if (!haveflags || phase == "") { print "run.md has no flags: or phase: line" > "/dev/stderr"; exit 2 }
    if (!("skipPlanRoast" in flag) || !("skipCodeRoast" in flag)) { print "flags: line lacks skipPlanRoast= or skipCodeRoast=" > "/dev/stderr"; exit 2 }
    if (phase !~ /^(design|roast-design|capped-blocking|code|roast-code|fix-loop|report|finish|done)$/) { print "not a phase token: " phase > "/dev/stderr"; exit 2 }
    if (dcapped) addq("design roast capped-blocking")
    sweepok = tip != "" && havecb && trim(cb["sweep"]) != "" && sweepq(trim(cb["sweep"])) == ""
    for (i = 1; i <= ndv; i++) if (!(dvsweep[i] && sweepok)) addq(dv[i])
    if (truthy(flag["skipPlanRoast"])) addq("plan roast skipped")
    if (truthy(flag["skipCodeRoast"])) addq("code roast skipped")
    if (havecb) {
      split("escalated pendingRetry parked stalled", need, " ")
      for (i = 1; i <= 4; i++) if (!(need[i] in hascb)) addq(need[i] " bucket: none recorded")
      if (!isempty(cb["parked"])) addq("code findings parked")
      pending = countids(cb["pendingRetry"])
      if (pending) addq("tasks pending retry")
      esc += countids(cb["escalated"])
      review = trim(cb["review"])
      if (review != "CLEAN" && review !~ /^ready( |$)/) addq("final review: " (review == "" ? "none recorded" : review))
      addq(sweepq(trim(cb["sweep"])))
      codestalled = truthy(cb["stalled"])
    } else if (phase == "report" || phase == "finish" || phase == "done") {
      addq("final review: none recorded")
      addq("sweep: none recorded")
    }
    nc = split(ENVIRON["RS_CONTINUITY"], cq, "\n")
    for (i = 1; i <= nc; i++) addq(cq[i])
    suffix = ""
    for (i = 1; i <= nq; i++) suffix = suffix (i == 1 ? " [degraded: " : ", ") qs[i]
    if (nq) suffix = suffix "]"
    if (stalled != "") print "status: stalled at phase " stalled
    else if (phase == "capped-blocking") print "status: stalled at phase capped-blocking"
    else if (codestalled) print "status: stalled at phase code"
    else if (blocking || esc || pending) print "status: completed with " (blocking + 0) " unresolved Blocking, " (esc + 0) " escalations" suffix
    else print "status: clean" suffix
    for (i = 1; i <= nq; i++) print "qualifier: " qs[i]
  }
' "$run"
