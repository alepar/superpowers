#!/usr/bin/env bash
# Validates one step-back record before the orchestrator acts on it. Both roast fix loops (super-auto
# phase 5 and super-design's Adversarial Review Loop) use it.
#
#   step-back-check --step-back STEP_BACK_FILE --keys KEYS_FILE [--ledger LEDGER_FILE]
#
# STEP_BACK_FILE: the step-back output, in step-back-prompt.md's fields. KEYS_FILE: the
# pre-dissolution key set, every round's confirmed finding keys so far, one `[SEV] <location>` per
# line (a leading `rN ` is stripped). LEDGER_FILE: the findings ledger; only its `triggers:` line is
# read: `triggers: none` or `triggers: <name>(<evidence>)[, <name>(<evidence>)]`.
#
# Checks:
#   decision:  present and `local` or `redesign`; `patch` is read as `local` (the one place that
#              mapping lives).
#   triggers:  `none` or a `, `-separated list of trigger names. Canonical names. Mechanical:
#              `no-progress`, `recurrence` (computed only by findings-ledger). Semantic: `shared-cause`,
#              `defect-type` (defined only in step-back-prompt.md; add a new semantic trigger to
#              SEMANTIC below). Every other name is mechanical.
#              With --ledger: `local` is rejected while the ledger's triggers: line names a mechanical
#              trigger; `redesign` is rejected with `triggers: none`; a cited mechanical trigger the
#              ledger does not list is rejected; a missing triggers: field is rejected. Without
#              --ledger the triggers: field is not required (callers mid-upgrade) and the
#              ledger-dependent checks do not run.
#   scope:     for `redesign`, present and starting with `inside` or `outside`.
#   keys:      every `dissolves:` and `remains:` key, in canonical form `[SEV] <location>`, matches a
#              KEYS_FILE line after both lose any leading `rN `. A list is split only on `, [` (or
#              `, rN [`), so keys may contain `, ` or `; `; `none` or an empty value lists no keys.
#
# Prints `ok`, or one `reject: <reason>` line per problem. Pure bash and awk: needs no jq, so it
# never prints JQ_UNAVAILABLE.
# Exit 0 ok, 3 rejected, 2 bad input (including an unreadable ledger or one without a triggers: line).
set -euo pipefail

usage() { echo "usage: step-back-check --step-back STEP_BACK_FILE --keys KEYS_FILE [--ledger LEDGER_FILE]" >&2; exit 2; }
stepback='' keys='' ledger=''
while [ $# -gt 0 ]; do
  case "$1" in
    --step-back) [ $# -ge 2 ] || usage; stepback=$2; shift 2 ;;
    --keys) [ $# -ge 2 ] || usage; keys=$2; shift 2 ;;
    --ledger) [ $# -ge 2 ] || usage; ledger=$2; shift 2 ;;
    *) usage ;;
  esac
done
[ -n "$stepback" ] && [ -n "$keys" ] || usage
[ -f "$stepback" ] || { echo "step-back file not found: $stepback" >&2; exit 2; }
[ -f "$keys" ] || { echo "keys file not found: $keys" >&2; exit 2; }
ledgertriggers=''
if [ -n "$ledger" ]; then
  [ -f "$ledger" ] || { echo "ledger file not found: $ledger" >&2; exit 2; }
  ledgertriggers=$(awk '/^triggers:/ { sub(/^triggers:[ \t]*/, ""); sub(/[ \t\r]+$/, ""); print; found = 1; exit } END { if (!found) exit 1 }' "$ledger") ||
    { echo "ledger has no triggers: line: $ledger" >&2; exit 2; }
fi

awk -v haveledger="$([ -n "$ledger" ] && echo 1 || echo 0)" -v ledgertriggers="$ledgertriggers" '
  BEGIN { SEMANTIC = " shared-cause defect-type " }
  function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
  function value(s) { sub(/^[ \t]*[a-z]+:/, "", s); return trim(s) }
  function reject(r) { rejects[++nr] = "reject: " r }
  function canon(k) { k = trim(k); sub(/^r[0-9]+ /, "", k); return k }
  function checkkey(field, k,   c) { c = canon(k); if (c != "" && !(c in known)) reject(field ": unknown key \047" trim(k) "\047") }
  function checkkeys(field, v,   s) {
    v = trim(v)
    if (v == "" || tolower(v) == "none") return
    s = v
    while (match(s, /,[ \t]*(r[0-9]+ )?\[/)) { checkkey(field, substr(s, 1, RSTART - 1)); s = substr(s, RSTART + 1) }
    checkkey(field, s)
  }
  FILENAME == ARGV[1] { k = canon($0); if (k != "") known[k] = 1; next }
  { sub(/\r$/, "") }
  !hasdecision && /^[ \t]*decision:/ { hasdecision = 1; decision = value($0); next }
  !hastriggers && /^[ \t]*triggers:/ { hastriggers = 1; triggers = value($0); next }
  !hasscope && /^[ \t]*scope:/ { hasscope = 1; scope = value($0); next }
  /^[ \t]*dissolves:/ { dissolves = value($0); next }
  /^[ \t]*remains:/ { remains = value($0); next }
  END {
    if (decision == "patch") decision = "local"
    if (decision == "") reject("decision: missing")
    else if (decision != "local" && decision != "redesign") reject("decision: \047" decision "\047 is not local or redesign")
    if (decision == "redesign") {
      if (scope == "") reject("scope: missing (required for redesign)")
      else if (scope !~ /^(inside|outside)([^a-z]|$)/) reject("scope: \047" scope "\047 does not start with inside or outside")
    }
    if (haveledger == 1) {
      # Names in the ledger line: `name(` after the start or a ", " separator (evidence may hold
      # commas); a value with no "(" is a bare comma list of names. `none` lists nothing.
      s = ledgertriggers
      if (tolower(s) == "none") s = ""
      else if (index(s, "(") == 0) { m = split(s, bare, /,[ \t]*/); s = ""; for (i = 1; i <= m; i++) s = s (i > 1 ? ", " : "") bare[i] "(" }
      while (match(s, /(^|, )[a-z-]+\(/)) {
        n = substr(s, RSTART, RLENGTH); sub(/^, /, "", n); sub(/\($/, "", n)
        lnames[n] = 1; mech = mech (mech == "" ? "" : ", ") n
        s = substr(s, RSTART + RLENGTH)
      }
      if (!hastriggers) reject("triggers: missing")
      else {
        none = (tolower(triggers) == "none")
        if (decision == "local" && mech != "") reject("decision: local while ledger names mechanical trigger(s): " mech)
        if (decision == "redesign" && none) reject("triggers: none with decision redesign")
        if (!none) {
          m = split(triggers, cited, /,[ \t]*/)
          for (i = 1; i <= m; i++) {
            c = trim(cited[i]); sub(/\(.*$/, "", c)
            if (c == "" || index(SEMANTIC, " " c " ") > 0) continue
            if (!(c in lnames)) reject("triggers: \047" c "\047 is mechanical and the ledger does not list it")
          }
        }
      }
    }
    checkkeys("dissolves", dissolves)
    checkkeys("remains", remains)
    if (nr == 0) { print "ok"; exit 0 }
    for (i = 1; i <= nr; i++) print rejects[i]
    exit 3
  }
' "$keys" "$stepback"
