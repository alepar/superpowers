#!/usr/bin/env bash
# Dependency-graph numbers for the open part of one epic's tree, for the report-only edge audit.
# Nodes: in-tree beads (epic-tree's structural membership) that are not closed and not labelled
# `blocker` or `sp:review` (a review bead tracks a task that is already implemented). A bead
# waits on its open in-tree `blocks` dependencies; an open epic waits on each of its open in-tree
# children (so a bead blocked by an epic waits for that epic's whole subtree).
#   openLeaves    = open non-epic nodes
#   depth         = the most non-epic nodes on any chain of waits (epics add no depth)
#   criticalPath  = one such longest chain, waiting bead first, epics included
# A wait cycle is reported on stderr and the closing edge ignored.
#
# Usage: bash edge-stats EPIC_ID
# Prints one JSON object {"openLeaves":N,"depth":N,"criticalPath":[...]} on stdout.
# Exit 0 ok, 2 bad input or unknown EPIC_ID, 4 jq unavailable (prints a JQ_UNAVAILABLE: line on
# stdout).
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: edge-stats EPIC_ID" >&2
  exit 2
fi
epic=$1
here=$(cd "$(dirname "$0")" && pwd)

command -v jq >/dev/null 2>&1 || {
  echo "JQ_UNAVAILABLE: jq is not installed, so compute this by hand from \`bd list --all --json --limit 0\`. A bead's parent is the \`depends_on_id\` of its \`dependencies\` entry with \`type\` \"parent-child\"; it is in the tree when it is ${epic} or its parent chain reaches ${epic}. Keep in-tree beads whose \`status\` is not \"closed\" and whose \`labels\` include neither \"blocker\" nor \"sp:review\". openLeaves = how many of those have \`issue_type\` other than \"epic\". A kept bead waits on each kept bead named by its \`dependencies\` entries with \`type\` \"blocks\"; a kept epic also waits on each of its kept children. depth = the largest number of non-epic beads on any chain of waits (epics count 0). criticalPath = the ids along one longest chain, waiting bead first. Output one JSON object {\"openLeaves\":N,\"depth\":N,\"criticalPath\":[...]}."
  exit 4
}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
bd list --all --json --limit 0 > "$tmp/dump.json"
bash "$here/epic-tree" --from "$tmp/dump.json" "$epic" > "$tmp/members"

# N<TAB>id<TAB>status<TAB>issue_type<TAB>excluded(0|1: a blocker or review bead); D<TAB>bead<TAB>depends_on<TAB>type
jq -r '
  .[] | .id as $c |
  "N\t\($c)\t\(.status)\t\(.issue_type)\t\(if ((.labels // []) | (index("blocker") or index("sp:review"))) then 1 else 0 end)",
  ( (.dependencies // [])[] | select(.type == "blocks" or .type == "parent-child")
    | "D\t\($c)\t\(.depends_on_id)\t\(.type)" )' "$tmp/dump.json" > "$tmp/graph" ||
  { echo "could not parse the bd list dump" >&2; exit 2; }

awk -F '\t' '
  FNR == NR { member[$1] = 1; next }
  $1 == "N" && ($2 in member) && $3 != "closed" && $5 == 0 {
    node[$2] = 1; order[++n] = $2; w[$2] = ($4 == "epic") ? 0 : 1; if ($4 != "epic") leaves++
    next
  }
  $1 == "D" { dep[++nd] = $2 SUBSEP $3 SUBSEP $4 }
  function longest(id,   k, y, v, best, bestNext) {
    if (id in memo) return memo[id]
    onstack[id] = 1; best = 0; bestNext = ""
    for (k = 1; k <= nadj[id]; k++) {
      y = adj[id, k]
      if (y in onstack) { print "wait cycle: " id " -> " y " (edge ignored)" > "/dev/stderr"; continue }
      v = longest(y)
      if (v > best || bestNext == "") { best = v; bestNext = y }
    }
    delete onstack[id]
    nxt[id] = bestNext
    return memo[id] = w[id] + best
  }
  END {
    for (i = 1; i <= nd; i++) {
      split(dep[i], d, SUBSEP)
      if (!(d[1] in node) || !(d[2] in node)) continue
      # blocks: the bead waits on its blocker; parent-child: the open epic (d[2]) waits on its child.
      if (d[3] == "blocks") { a = d[1]; b = d[2] } else { a = d[2]; b = d[1] }
      adj[a, ++nadj[a]] = b
    }
    depth = 0; start = ""
    for (i = 1; i <= n; i++) { v = longest(order[i]); if (v > depth) { depth = v; start = order[i] } }
    while (start != "" && w[start] == 0) start = nxt[start]   # the chain starts at a waiting bead
    path = ""
    for (id = start; id != ""; id = nxt[id]) path = path (path == "" ? "" : ",") "\"" id "\""
    printf "{\"openLeaves\":%d,\"depth\":%d,\"criticalPath\":[%s]}\n", leaves, depth, path
  }' "$tmp/members" "$tmp/graph"
