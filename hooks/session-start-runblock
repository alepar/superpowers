#!/usr/bin/env bash
# SessionStart (matcher: compact) hook entry for Claude Code: re-injects the run block of an active
# super-auto / super-code run after compaction.
# Usage: session-start-runblock card|state   (hook JSON on stdin)
# Emits hookSpecificOutput.additionalContext only when a live marker resolves; otherwise no output.
# Always exits 0.
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=run-block.sh
. "$SCRIPT_DIR/run-block.sh" 2>/dev/null || exit 0

part="${1:-}"
case "$part" in card|state) ;; *) exit 0 ;; esac

rb_read_stdin
sid=$(rb_field session_id)
[ -n "$sid" ] || sid="${CLAUDE_CODE_SESSION_ID:-}"
cwd=$(rb_field cwd)

rb_is_subagent && exit 0
rb_resolve "$sid" "$cwd" || exit 0

if text=$(rb_digest "$part" 9000 5 2>/dev/null); then
  :
elif [ "$part" = card ]; then
  text=$(cat "$RB_CARD" 2>/dev/null) || exit 0
  [ -n "$text" ] || exit 0
else
  text="$RB_STATE_FALLBACK"
fi

text=$(printf '%s' "$text" | rb_sanitize)
if [ "$(printf '%s' "$text" | LC_ALL=C wc -c | tr -d ' ')" -gt 9500 ]; then
  cut=$(printf '%s' "$text" | LC_ALL=C head -c 9500)
  case "$cut" in
    *$'\n'*) cut="${cut%$'\n'*}" ;;
    *) cut=$(printf '%s' "$cut" | iconv -f UTF-8 -t UTF-8 -c 2>/dev/null || printf '%s' "$cut") ;;
  esac
  text="$cut"
fi

rb_emit_claude "$text"
exit 0
